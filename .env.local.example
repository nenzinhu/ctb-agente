# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Painel master ----
ADMIN_USERNAME=nenzinhu
# Gere com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 12))"
# Sem esta variável o painel aceita qualquer senha (apenas em desenvolvimento).
ADMIN_PASSWORD_HASH=

# ---- Provedores de IA (cadeia de reserva, na ordem) ----
# 1) resposta rápida
GROQ_API_KEY=
# 2) resposta rápida (alternativa)
NVIDIA_API_KEY=
# 3) resposta analítica
OPENROUTER_API_KEY=
# 4) resposta analítica + embeddings
MISTRAL_API_KEY=

# ---- Cloudflare Turnstile (anti-bot) ----
# O widget só aparece quando NEXT_PUBLIC_TURNSTILE_SITE_KEY está definida.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Aplicação ----
NEXT_PUBLIC_APP_NAME=CTB Agente
# Valor inicial; depois disso o master ajusta no painel (/admin → Limites)
RATE_LIMIT_QUERIES_PER_HOUR=30

# ---- Testes end-to-end (Playwright) ----
# E2E_SEEDED=1 habilita os testes que dependem de base populada
E2E_SEEDED=
E2E_ADMIN_USER=nenzinhu
E2E_ADMIN_PASSWORD=
