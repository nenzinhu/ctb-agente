# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Chaves modernas recomendadas
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Compatibilidade com projetos que ainda usam as chaves JWT legadas
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Painel master ----
# Usuário do painel (opcional; padrão: nenzinhu)
ADMIN_USERNAME=nenzinhu
# Gere com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 12))"
# Sem esta variável o painel aceita qualquer senha (apenas em desenvolvimento).
ADMIN_PASSWORD_HASH=

# ---- IA de texto (cadeia fixa, na ordem — ver lib/ai/providers/registry.ts) ----
# 1) Groq
GROQ_API_KEY=
# 2) Cerebras
CEREBRAS_API_KEY=
# 3) Cohere
COHERE_API_KEY=
# 4) OpenRouter — somente os modelos :free autorizados no registro
OPENROUTER_API_KEY=

# ---- Vetores semânticos do RAG (Mistral é usada somente para embeddings) ----
MISTRAL_API_KEY=

# ---- Cloudflare Turnstile (anti-bot) ----
# O widget só aparece quando NEXT_PUBLIC_TURNSTILE_SITE_KEY está definida.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Aplicação ----
NEXT_PUBLIC_APP_NAME=CTB Agente
# Valor inicial; depois disso o master ajusta no painel (/admin → Limites)
RATE_LIMIT_QUERIES_PER_HOUR=30
# Protege GET /api/cron/clear-cache (a Vercel Cron envia "Bearer $CRON_SECRET")
CRON_SECRET=


# ---- Testes end-to-end (Playwright) ----
# E2E_SEEDED=1 habilita os testes que dependem de base populada
E2E_SEEDED=
E2E_ADMIN_USER=nenzinhu
E2E_ADMIN_PASSWORD=
